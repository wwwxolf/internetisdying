{
  "name": "internetisdying",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/share/*",
      "/v4/share/*",
      "/api/war-momentum",
      "/api/v4-summary"
    ]
  },
  "main": "./src/share-worker.js"
}

